    "typeorm": "cross-env TS_NODE_PROJECT=apps/api/tsconfig.typeorm.json typeorm-ts-node-commonjs",
    "db:migration:generate": "npm run typeorm -- migration:generate -d apps/api/src/database/data-source.ts",
    "db:migration:show": "npm run typeorm -- migration:show -d apps/api/src/database/data-source.ts",
    "db:migration:run": "npm run typeorm -- migration:run -d apps/api/src/database/data-source.ts",
    "db:migration:revert": "npm run typeorm -- migration:revert -d apps/api/src/database/data-source.ts",
    "db:schema:log": "npm run typeorm -- schema:log -d apps/api/src/database/data-source.ts",
    "db:seed": "cross-env TS_NODE_PROJECT=apps/api/tsconfig.typeorm.json ts-node apps/api/src/database/seed.ts"
  },
