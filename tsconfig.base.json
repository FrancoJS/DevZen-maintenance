{
  "compileOnSave": false,
  "compilerOptions": {
    "rootDir": ".",
    "sourceMap": true,
    "declaration": false,
    "moduleResolution": "bundler",
    "emitDecoratorMetadata": true,
    "experimentalDecorators": true,
    "importHelpers": true,
    "target": "es2015",
    "module": "esnext",
    "lib": [
      "es2020",
      "dom"
    ],
    "skipLibCheck": true,
    "skipDefaultLibCheck": true,
    "strict": false,
    "paths": {
      "@spartan-ng/helm/card": [
        "./apps/web/src/app/shared/ui/card/src/index.ts"
      ],
      "@spartan-ng/helm/utils": [
        "./apps/web/src/app/shared/ui/utils/src/index.ts"
      ],
      "@spartan-ng/helm/button": [
        "./apps/web/src/app/shared/ui/button/src/index.ts"
      ],
      "@spartan-ng/helm/badge": [
        "./apps/web/src/app/shared/ui/badge/src/index.ts"
      ],
      "@spartan-ng/helm/avatar": [
        "./apps/web/src/app/shared/ui/avatar/src/index.ts"
      ],
      "@spartan-ng/helm/dropdown-menu": [
        "./apps/web/src/app/shared/ui/dropdown-menu/src/index.ts"
      ],
      "@spartan-ng/helm/tooltip": [
        "./apps/web/src/app/shared/ui/tooltip/src/index.ts"
      ],
      "@spartan-ng/helm/separator": [
        "./apps/web/src/app/shared/ui/separator/src/index.ts"
      ],
      "@spartan-ng/helm/sidebar": [
        "./apps/web/src/app/shared/ui/sidebar/src/index.ts"
      ],
      "@spartan-ng/helm/input": [
        "./apps/web/src/app/shared/ui/input/src/index.ts"
      ],
      "@spartan-ng/helm/sheet": [
        "./apps/web/src/app/shared/ui/sheet/src/index.ts"
      ],
      "@spartan-ng/helm/skeleton": [
        "./apps/web/src/app/shared/ui/skeleton/src/index.ts"
      ],
      "@spartan-ng/helm/sonner": [
        "./apps/web/src/app/shared/ui/sonner/src/index.ts"
      ],
      "@spartan-ng/helm/pagination": [
        "./apps/web/src/app/shared/ui/pagination/src/index.ts"
      ],
      "@spartan-ng/helm/select": [
        "./apps/web/src/app/shared/ui/select/src/index.ts"
      ]
    }
  },
  "exclude": [
    "node_modules",
    "tmp"
  ]
}
